# GEMINI_API_KEY: Server-side only Gemini API key for AI Assistant & PDF extraction.
GEMINI_API_KEY=

# Initial Administrator credentials (server-side only, never exposed to client).
# Set ADMIN_PASSWORD before deploying to production so the admin account is provisioned automatically.
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=

# Optional database folder path (defaults to ./data; set to /var/data when attaching a Render Persistent Disk).
DATA_DIR=./data

# Optional application base URL.
APP_URL=
