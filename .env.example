# GEMINI_API_KEY: Server-side only Gemini API key for AI Assistant & PDF extraction.
GEMINI_API_KEY=

# Cloud SQL PostgreSQL connection settings (server-side only; do NOT use DATABASE_URL).
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Initial Administrator & Session configuration (server-side only, never exposed to client).
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=

# Optional local seed/backup data folder path (defaults to ./data).
DATA_DIR=./data

# Optional application base URL.
APP_URL=
